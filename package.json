{
  "name": "opencode-hermes-memory",
  "version": "0.4.0",
  "description": "Layered persistent memory plugin for OpenCode V2 — ported from Hermes agent",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "hermes-memory.ts",
    "hermes-memory-lib"
  ],
  "scripts": {
    "test": "bun run hermes-memory-lib/tests/regression.ts && bun run hermes-memory-lib/tests/v2-smoke.ts",
    "test:regression": "bun run hermes-memory-lib/tests/regression.ts",
    "test:v2": "bun run hermes-memory-lib/tests/v2-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check index.ts hermes-memory.ts hermes-memory-lib/",
    "lint:fix": "biome check --write index.ts hermes-memory.ts hermes-memory-lib/"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "hermes",
    "persistent-memory",
    "ai-agent",
    "llm"
  ],
  "license": "MIT",
  "author": {
    "name": "realchendahuang",
    "url": "https://github.com/realchendahuang"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realchendahuang/opencode-hermes-memory.git"
  },
  "bugs": {
    "url": "https://github.com/realchendahuang/opencode-hermes-memory/issues"
  },
  "homepage": "https://github.com/realchendahuang/opencode-hermes-memory#readme",
  "engines": {
    "bun": ">=1.0.0",
    "opencode": ">=2.0.0"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.11"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
